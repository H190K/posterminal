# Serverless Cloudflare POS Terminal - Environment Variables
# Canonical environment template for this project
# Copy this file to .env.local or use wrangler.toml for configuration
#
# Setup Instructions:
# 1. Required secrets: npx wrangler secret put <VARIABLE_NAME>
# 2. Optional config: Add to wrangler.toml [vars] section or set as environment variable

# =============================================================
# REQUIRED SECRETS (use: npx wrangler secret put <VARIABLE_NAME>)
# =============================================================

# Password for terminal dashboard login
TERMINAL_PASSWORD=your_secure_password_here

# Webhook authentication and verification
WEBHOOK_AUTH_SECRET=random_auth_secret_xyz789

# Link signing and session tokens
LINK_SIGNING_SECRET=random_link_secret_abc456

# PII encryption for customer data
PII_ENCRYPTION_SECRET=random_encryption_secret_def123

# Your SindiPay API key (get from https://sindipay.com/dashboard)
API_KEY=sp_live_xxxxxxxxxxxxxxxx

# =============================================================
# OPTIONAL SECRETS
# =============================================================

# Discord webhook URL for notifications (create webhook in Discord Server Settings)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/AbCdEfGhIjKlMnOpQrStUvWx

# =============================================================
# OPTIONAL CONFIGURATION
# =============================================================

# Your business/merchant name (used in receipts, titles, etc.)
MERCHANT_NAME=My Shop

# Contact email for customer support (shown in receipts and contact buttons)
MERCHANT_EMAIL=support@myshop.com

# WhatsApp number for customer support (with country code, no +)
# Example: 964770000000 for Iraq (+964 770000000)
MERCHANT_WHATSAPP=964770000000

# URL to your favicon (192x192px or larger, for PWA icons)
MERCHANT_FAVICON=https://example.com/favicon.png

# Service fee percentage added to payment amounts
# Set to 1.5 for 1.5% fee, 0 for no fee, or leave empty to use default
# Note: the configured percentage is only applied when the operator enables the fee toggle in the terminal UI
SERVICE_FEE_PERCENTAGE=1.5

# =============================================================
# CODE-LEVEL TEST OVERRIDES
# =============================================================

# SINDIPAY_TLD_OVERRIDE and SINDIPAY_API_KEY_OVERRIDE are optional constants
# in index.js for local testing. They are not Worker environment variables.
